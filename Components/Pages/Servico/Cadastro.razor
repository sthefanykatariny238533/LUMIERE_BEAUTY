@page "/servicos/cadastro"
@rendermode InteractiveServer

@using Lumiere_Beauty.Models
@using Lumiere_Beauty.DAO

@inject ServicoDAO dao
@inject NavigationManager NavigationManager

<PageTitle>Novo Serviço - Lumière Beauty</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1">Cadastro de Serviço</h2>
    </div>
</div>

<div class="custom-table-card p-4">

    <EditForm Model="servico" OnValidSubmit="Salvar">

        <DataAnnotationsValidator />

        <ValidationSummary class="alert alert-danger" />

        <div class="row mb-3">

            <div class="col-md-8">
                <label for="nome" class="form-label">Nome</label>

                <InputText id="nome"
                           class="form-control"
                           @bind-Value="servico.Nome" />

                <ValidationMessage For="() => servico.Nome" />
            </div>

            <div class="col-md-4">
                <label for="preco" class="form-label">Preço</label>

                <InputNumber id="preco"
                             class="form-control"
                             @bind-Value="servico.Preco" />

                <ValidationMessage For="() => servico.Preco" />
            </div>

        </div>

        <div class="row mb-3">

            <div class="col-md-12">
                <label for="categoria" class="form-label">
                    Categoria
                </label>

                <InputNumber id="categoria"
                             class="form-control"
                             @bind-Value="servico.IdCategoria" />

                <ValidationMessage For="() => servico.IdCategoria" />
            </div>

        </div>

        <div class="row mb-3">

            <div class="col-md-12">
                <label for="descricao" class="form-label">
                    Descrição
                </label>

                <InputTextArea id="descricao"
                               class="form-control"
                               rows="4"
                               @bind-Value="servico.Descricao" />

                <ValidationMessage For="() => servico.Descricao" />
            </div>

        </div>

        <div class="d-flex gap-2">

            <button type="submit" class="btn btn-primary">
                <i class="bi bi-check-lg"></i>
                Salvar
            </button>

            <a href="/servicos" class="btn btn-light border">
                Cancelar
            </a>

        </div>

    </EditForm>

</div>

@code {

    private Servico servico = new();

    private void Salvar()
    {
        dao.Inserir(servico);

        // Retorna para a página de serviços após salvar
        NavigationManager.NavigateTo("/servicos");
    }

}