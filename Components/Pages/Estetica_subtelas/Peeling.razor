@page "/peeling"

<PageTitle>Peeling</PageTitle>

<section class="pagina-peeling">

    <header class="cabecalho-peeling">

        <a href="/estetica" class="voltar">
            &#8592;
        </a>

        <div class="marca">

            <h1>LUMIÈRE BEAUTY</h1>

            <div class="subtitulo-marca">
                <span>ESTÉTICA</span>
                <span>•</span>
                <span>CABELOS</span>
                <span>•</span>
                <span>MAQUIAGEM</span>
            </div>

        </div>

    </header>


    <main class="conteudo-peeling">

        <div class="apresentacao-peeling">

            <div class="imagem-peeling">

                <img src="/Estetica/peeling.png"
                     alt="Peeling" />

            </div>


            <div class="informacoes-peeling">

                <h2>Peeling</h2>

                <p class="descricao">
                    Renovação e revitalização da pele.
                </p>

                <p class="texto-descricao">
                    Procedimento desenvolvido para promover a renovação
                    da pele, melhorar sua textura e proporcionar uma
                    aparência mais uniforme, saudável e revitalizada.
                </p>

            </div>

        </div>


        <section class="bloco-informacao">

            <h3>Benefícios:</h3>

            <ul class="lista-beneficios">

                <li>
                    <span class="check">✓</span>
                    Auxilia na renovação da pele.
                </li>

                <li>
                    <span class="check">✓</span>
                    Melhora a textura e uniformidade da pele.
                </li>

                <li>
                    <span class="check">✓</span>
                    Proporciona uma aparência mais revitalizada.
                </li>

            </ul>
        </section>

        <section class="bloco-informacao">

            <h3>Duração:</h3>

            <p class="duracao">

                <span class="icone-relogio">
                    ◷
                </span>

                Aproximadamente 1 hora.

            </p>
        </section>

        <section class="bloco-informacao">

            <h3>Para quem é indicado:</h3>

            <p class="indicacao">
                Indicado para pessoas que desejam melhorar a aparência,
                textura e luminosidade da pele.
            </p>
        </section>
    </main>

    <footer class="rodape-agendamento">

        <div class="preco">

            <span>A partir de</span>
            <strong>R$ 130,00</strong>

        </div>

        <a href="/agendamento" class="botao-agendar">
            AGENDAR AGORA
        </a>
    </footer>
</section>
