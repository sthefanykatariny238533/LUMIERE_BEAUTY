@page "/extensao-cilios"

<PageTitle>Extensão de Cílios</PageTitle>

<section class="pagina-cilios">

    <header class="cabecalho-cilios">

        <a href="/estetica" class="voltar">
            &#8592;
        </a>

        <div class="marca">
            <h1>LUMIÈRE BEAUTY</h1>

            <div class="subtitulo-marca">
                <span>ESTÉTICA</span>
                <span>•</span>
                <span>CABELOS</span>
                <span>•</span>
                <span>MAQUIAGEM</span>
            </div>
        </div>
    </header>

    <main class="conteudo-cilios">

        <div class="apresentacao-cilios">

            <div class="imagem-cilios">

                <img src="/Estetica/extensao de cilios.png" alt="Extensão de Cílios" />

            </div>

            <div class="informacoes-cilios">

                <h2>Extensão de Cílios</h2>

                <p class="descricao">
                    Realce o olhar com mais volume e definição.
                </p>

                <p class="texto-descricao">
                    Procedimento realizado para alongar e dar volume
                    aos cílios, proporcionando um olhar mais marcante,
                    delicado e harmonioso.
                </p>

            </div>

        </div>

        <section class="bloco-informacao">

            <h3>Benefícios:</h3>

            <ul class="lista-beneficios">

                <li>
                    <span class="check">✓</span>
                    Realça e valoriza o olhar.
                </li>

                <li>
                    <span class="check">✓</span>
                    Proporciona mais volume e comprimento aos cílios.
                </li>

                <li>
                    <span class="check">✓</span>
                    Resultado personalizado de acordo com o estilo desejado.
                </li>

            </ul>

        </section>

        <section class="bloco-informacao">

            <h3>Duração:</h3>

            <p class="duracao">

                <span class="icone-relogio">
                    ◷
                </span>

                Aproximadamente 2 horas.

            </p>

        </section>

        <section class="bloco-informacao">

            <h3>Para quem é indicado:</h3>

            <p class="indicacao">
                Indicada para pessoas que desejam cílios mais longos,
                volumosos e um olhar mais destacado.
            </p>

        </section>

    </main>

    <footer class="rodape-agendamento">

        <div class="preco">

            <span>A partir de</span>
            <strong>R$ 150,00</strong>

        </div>

        <a href="/agendamento" class="botao-agendar">
            AGENDAR AGORA
        </a>

    </footer>

</section>
