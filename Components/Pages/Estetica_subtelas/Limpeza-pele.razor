@page "/limpeza-pele"

<PageTitle>Limpeza de Pele</PageTitle>

<section class="pagina-limpeza">

    <header class="cabecalho-limpeza">

        <a href="/estetica" class="voltar">
            &#8592;
        </a>

        <div class="marca">

            <h1>LUMIÈRE BEAUTY</h1>

            <div class="subtitulo-marca">
                <span>ESTÉTICA</span>
                <span>•</span>
                <span>CABELOS</span>
                <span>•</span>
                <span>MAQUIAGEM</span>
            </div>
        </div>
    </header>

    <main class="conteudo-limpeza">

        <div class="apresentacao-limpeza">

            <div class="imagem-limpeza">

                <img src="/Estetica/limpeza de pele.png" alt="Limpeza de Pele" />
            </div>


            <div class="informacoes-limpeza">

                <h2>Limpeza de Pele</h2>

                <p class="descricao">
                    Cuidados especiais para sua pele.
                </p>

                <p class="texto-descricao">
                    Procedimento desenvolvido para remover impurezas,
                    controlar a oleosidade e proporcionar uma pele
                    mais limpa, saudável e revitalizada.
                </p>

            </div>

        </div>

        <section class="bloco-informacao">

            <h3>Benefícios:</h3>

            <ul class="lista-beneficios">

                <li>
                    <span class="check">✓</span>
                    Remove impurezas da pele.
                </li>

                <li>
                    <span class="check">✓</span>
                    Auxilia no controle da oleosidade.
                </li>

                <li>
                    <span class="check">✓</span>
                    Deixa a pele mais limpa e revitalizada.
                </li>

            </ul>

        </section>

        <section class="bloco-informacao">

            <h3>Duração:</h3>

            <p class="duracao">

                <span class="icone-relogio">
                    ◷
                </span>

                Aproximadamente 1 hora.

            </p>

        </section>

        <section class="bloco-informacao">

            <h3>Para quem é indicado:</h3>

            <p class="indicacao">
                Indicada para pessoas que desejam manter a pele
                limpa, saudável e bem cuidada.
            </p>

        </section>

    </main>

    <footer class="rodape-agendamento">

        <div class="preco">

            <span>A partir de</span>

            <strong>R$ 120,00</strong>

        </div>

        <a href="/agendamento" class="botao-agendar">
            AGENDAR AGORA
        </a>
    </footer>
</section>
