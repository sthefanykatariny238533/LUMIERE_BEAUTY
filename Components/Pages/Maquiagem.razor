@page "/maquiagem"

<PageTitle>Maquiagem</PageTitle>

<section class="pagina-maquiagem">

    <section class="banner-maquiagem.png">

        <a href="/" class="voltar">
            &#8592;
        </a>

        <div class="titulo-banner">

            <div class="linha"></div>

            <div>

                <h1>MAQUIAGEM</h1>

                <p>Escolha o serviço ideal para você.</p>

            </div>

            <div class="linha"></div>

        </div>

    </section>

    <section class="lista-servicos">

        <div class="servico">

            <img src="/Maquiagem/maquiagem_social.png" alt="Maquiagem Social">

            <div class="informacoes">

                <h2>Maquiagem Social</h2>

                <p>Para eventos e ocasiões especiais.</p>

                <a href="/social">Ver modelos</a>

            </div>

            <a href="/social" class="seta">&#8250;</a>

        </div>

        <div class="servico">

            <img src="/Maquiagem/maquiagem_noiva.png" alt="Maquiagem Noiva">

            <div class="informacoes">

                <h2>Maquiagem Noiva</h2>

                <p>Realce sua beleza para o grande dia.</p>

                <a href="/noiva">Ver modelos</a>

            </div>

            <a href="/noiva" class="seta">&#8250;</a>

        </div>

        <div class="servico">

            <img src="/Maquiagem/maquiagem_casual.png" alt="Maquiagem Casual">

            <div class="informacoes">

                <h2>Maquiagem Casual</h2>

                <p>Para o dia a dia.</p>

                <a href="/casual">Ver modelos</a>

            </div>

            <a href="/casual" class="seta">&#8250;</a>

        </div>

        <div class="servico">

            <img src="/Maquiagem/maquiagem artistica.png" alt="Maquiagem Artística">

            <div class="informacoes">

                <h2>Maquiagem Artística</h2>

                <p>Para produções artísticas e caracterizações especiais.</p>

                <a href="/artistica">Ver modelos</a>

            </div>

            <a href="/artistica" class="seta">&#8250;</a>

        </div> 

    </section>

</section>