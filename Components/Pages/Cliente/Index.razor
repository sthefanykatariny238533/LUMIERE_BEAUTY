@page "/clientes"

@using Lumiere_Beauty.Models
@using Lumiere_Beauty.DAO

@inject ClienteDAO ClienteDAO

<PageTitle>Clientes - Lumière Beauty</PageTitle>

<section class="pagina-clientes">

    <section class="banner-clientes">

        <a href="/" class="voltar">
            &#8592;
        </a>

        <div class="titulo-banner-clientes">

            <div class="linha-clientes"></div>

            <div class="texto-banner-clientes">
                <h1>CLIENTES</h1>
                <p>Consulta de clientes cadastrados.</p>
            </div>

            <div class="linha-clientes"></div>

        </div>

    </section>


    <section class="area-clientes">

        <div class="cabecalho-clientes">
            <h2>Clientes cadastrados</h2>
            <p>Confira os clientes registrados no sistema Lumière Beauty.</p>
        </div>


        <div class="tabela-clientes">

            <table>

                <thead>

                    <tr>
                        <th>Id</th>
                        <th>Nome completo</th>
                        <th>E-mail</th>
                    </tr>

                </thead>


                <tbody>

                    @foreach (var cliente in clientes)
                    {
                        <tr>

                            <td>
                                @cliente.Id
                            </td>

                            <td class="nome-cliente">
                                @cliente.NomeCompleto
                            </td>

                            <td class="email-cliente">
                                @cliente.Email
                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </section>

</section>


@code {

    private List<Cliente> clientes = new();

    protected override void OnInitialized()
    {
        clientes = ClienteDAO.Listar();
    }

}