@page "/categoria/cadastro"

@rendermode InteractiveServer

@using Lumiere_Beauty.Models
@using Lumiere_Beauty.DAO

@inject CategoriaDAO dao
@inject NavigationManager NavigationManager

<PageTitle>Nova Categoria - Lumière Beauty</PageTitle>

<section class="pagina-categoria-cadastro">

    <div class="cabecalho-categoria-cadastro">

        <h2>
            Cadastro de Categoria
        </h2>

        <p>
            Cadastre uma nova categoria no sistema.
        </p>

    </div>


    <div class="categoria-card">

        <EditForm Model="categoria" OnValidSubmit="Salvar">

            <DataAnnotationsValidator />

            <ValidationSummary class="categoria-validation-summary" />

            <div class="categoria-campo">

                <label for="nome" class="categoria-label">
                    Nome da Categoria
                </label>

                <InputText id="nome"
                           class="categoria-input"
                           @bind-Value="categoria.Nome" />

                <ValidationMessage For="() => categoria.Nome"
                                   class="categoria-validation" />

            </div>


            <div class="categoria-botoes">

                <button type="submit"
                        class="categoria-btn-salvar">

                    <i class="bi bi-check-lg"></i>
                    Salvar

                </button>


                <a href="/categoria"
                       class="categoria-btn-cancelar">

                    <i class="bi bi-x-lg"></i>
                    Cancelar

                </a>

            </div>

        </EditForm>

    </div>

</section>


@code {

    private Categoria categoria = new();

    private void Salvar()
    {
        dao.Inserir(categoria);

        NavigationManager.NavigateTo("/categoria");
    }

}