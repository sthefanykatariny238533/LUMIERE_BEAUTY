@page "/categoria/cadastro"
@rendermode InteractiveServer

@using Lumiere_Beauty.Models
@using Lumiere_Beauty.DAO

@inject CategoriaDAO dao
@inject NavigationManager NavigationManager

<PageTitle>Nova Categoria - Lumière Beauty</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">

    <div>
        <h2 class="fw-bold mb-1">Cadastro de Categoria</h2>
        <p>Cadastre uma nova categoria no sistema.</p>
    </div>

</div>

<div class="custom-table-card p-4">

    <EditForm Model="categoria" OnValidSubmit="Salvar">

        <DataAnnotationsValidator />

        <ValidationSummary class="alert alert-danger" />

        <div class="row mb-3">

            <div class="col-md-12">

                <label for="nome" class="form-label">
                    Nome da Categoria
                </label>

                <InputText id="nome"
                           class="form-control"
                           @bind-Value="categoria.Nome" />

                <ValidationMessage For="() => categoria.Nome" />

            </div>

        </div>

        <div class="d-flex gap-2">

            <button type="submit" class="btn btn-primary">
                <i class="bi bi-check-lg"></i>
                Salvar
            </button>

            <a href="/categoria" class="btn btn-light border">
                Cancelar
            </a>

        </div>

    </EditForm>

</div>

@code {

    private Categoria categoria = new();

    private void Salvar()
    {
        dao.Inserir(categoria);

        NavigationManager.NavigateTo("/categoria");
    }

}