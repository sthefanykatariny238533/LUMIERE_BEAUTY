@page "/categorias"

@using Lumiere_Beauty.Models
@using Lumiere_Beauty.DAO

@inject CategoriaDAO CategoriaDAO

<PageTitle>Categorias - Lumière Beauty</PageTitle>

<section class="pagina-clientes">

    <section class="banner-clientes">

        <a href="/" class="voltar">
            &#8592;
        </a>

        <div class="titulo-banner-clientes">

            <div class="linha-clientes"></div>

            <div class="texto-banner-clientes">
                <h1>CATEGORIAS</h1>
                <p>Consulta de categorias cadastradas.</p>
            </div>

            <div class="linha-clientes"></div>

        </div>

    </section>

    <section class="area-clientes">

        <div class="cabecalho-clientes">

            <div class="texto-clientes">

                <h2 class="fw-bold mb-1">
                    Categorias cadastradas
                </h2>

                <p>
                    Confira as categorias disponíveis no Lumière Beauty.
                </p>

            </div>

            <div class="botao-categoria">

                <a href="/categorias/cadastro" class="btn btn-primary">
                    <i class="bi bi-plus-lg"></i>
                    Nova Categoria
                </a>

            </div>

        </div>

        <div class="tabela-clientes">

            <table>

                <thead>

                    <tr>
                        <th>Id</th>
                        <th>Categoria</th>
                    </tr>

                </thead>

                <tbody>

                    @foreach (var categoria in categorias)
                    {
                        <tr>

                            <td>
                                @categoria.Id
                            </td>

                            <td class="nome-categoria">
                                @categoria.Nome
                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </section>

</section>

@code {

    private List<Categoria> categorias = new();

    protected override void OnInitialized()
    {
        categorias = CategoriaDAO.Listar();
    }

}