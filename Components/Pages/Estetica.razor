@page "/estetica"

<PageTitle>Estética</PageTitle>

<section class="pagina-estetica">

    <section class="banner-estetica">

        <a href="/" class="voltar">
            &#8592;
        </a>

        <div class="titulo-banner">

            <div class="linha"></div>

            <div class="texto-banner">
                <h1>ESTÉTICA</h1>
                <p>Escolha o serviço ideal para você.</p>
            </div>

            <div class="linha"></div>

        </div>

    </section>


    <section class="lista-servicos">

        <div class="servico">

            <img src="/Estetica/Limpeza de pele.png"
                 alt="Limpeza de Pele">

            <div class="informacoes">

                <h2>Limpeza de Pele</h2>

                <p>
                    Pele renovada e saudável.
                </p>

                <a href="/Pele">
                    Ver modelos
                </a>

            </div>

            <a href="/Pele" class="seta">
                &#8250;
            </a>

        </div>

        <div class="servico">

            <img src="/Estetica/Extensao de cilios.png"
                 alt="Extensão de Cílios">

            <div class="informacoes">

                <h2>Extensão de Cílios</h2>

                <p>
                    Olhar mais marcante e natural.
                </p>

                <a href="/cilios">
                    Ver modelos
                </a>

            </div>

            <a href="/cilios" class="seta">
                &#8250;
            </a>

        </div>


        <div class="servico">

            <img src="/Estetica/Design de sobrancelhas.png"
                 alt="Design de Sobrancelhas">

            <div class="informacoes">

                <h2>Design de Sobrancelhas</h2>

                <p>
                    Sobrancelhas perfeitas para você.
                </p>

                <a href="/sobrancelhas">
                    Ver modelos
                </a>

            </div>

            <a href="/sobrancelhas" class="seta">
                &#8250;
            </a>

        </div>

        <div class="servico">

            <img src="/Estetica/Peeling.png"
                 alt="Peeling">

            <div class="informacoes">

                <h2>Peeling</h2>

                <p>
                    Renovação e ação para a sua pele.
                </p>

                <a href="/peeling">
                    Ver modelos
                </a>

            </div>

            <a href="/peeling" class="seta">
                &#8250;
            </a>

        </div>


    </section>

</section>
