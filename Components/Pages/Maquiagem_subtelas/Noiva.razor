@page "/noiva"

<PageTitle>Maquiagem Noiva</PageTitle>

<section class="pagina-noiva">

    <header class="cabecalho-noiva">

        <a href="/maquiagem" class="voltar">
            &#8592;
        </a>

        <div class="marca">
            <h1>LUMIÈRE BEAUTY</h1>

            <div class="subtitulo-marca">
                <span>ESTÉTICA</span>
                <span>•</span>
                <span>CABELOS</span>
                <span>•</span>
                <span>MAQUIAGEM</span>
            </div>
        </div>

    </header>

    <main class="conteudo-noiva">

        <div class="apresentacao-noiva">


            <div class="imagem-noiva">
                <img src="/Maquiagem/maquiagem_noiva.png"
                     alt="Maquiagem Noiva" />
            </div>


            <div class="informacoes-noiva">

                <h2>Maquiagem Noiva</h2>

                <p class="descricao">
                    Realce sua beleza para o grande dia.
                </p>

                <p class="texto-descricao">
                    Maquiagem sofisticada, elegante e personalizada para realçar sua beleza natural, 
                    garantindo um acabamento impecável e de longa duração durante toda a cerimônia e
                    a celebração.
                </p>
            </div>
        </div>

        <section class="bloco-informacao">

            <h3>Benefícios:</h3>

            <ul class="lista-beneficios">

                <li>
                    <span class="check">✓</span>
                    Realce dos traços naturais da noiva.
                </li>

                <li>
                    <span class="check">✓</span>
                    Produtos de alta performance e fixação.
                </li>

                <li>
                    <span class="check">✓</span>
                    Personalização de acordo com o estilo da noiva, vestido e cerimônia.
                </li>
            </ul>
        </section>

        <section class="bloco-informacao">

            <h3>Duração:</h3>

            <p class="duracao">
                <span class="icone-relogio">◷</span>
                2 a 3 horas.
            </p>

        </section>

        <section class="bloco-informacao">

            <h3>Para quem é indicado:</h3>

            <p class="indicacao">
                Indicada para noivas que desejam uma maquiagem elegante, duradoura e personalizada.
            </p>

        </section>

    </main>

    <footer class="rodape-agendamento">

        <div class="preco">

            <span>A partir de</span>

            <strong>R$ 979,99</strong>

        </div>

        <a href="/agendamento" class="botao-agendar">
            AGENDAR AGORA
        </a>

    </footer>

</section>
