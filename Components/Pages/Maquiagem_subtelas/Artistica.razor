@page "/artistica"

<PageTitle>Maquiagem Artística</PageTitle>

<section class="pagina-artistica">

    <header class="cabecalho-artistica">

        <a href="/maquiagem" class="voltar">
            &#8592;
        </a>

        <div class="marca">
            <h1>LUMIÈRE BEAUTY</h1>

            <div class="subtitulo-marca">
                <span>ESTÉTICA</span>
                <span>•</span>
                <span>CABELOS</span>
                <span>•</span>
                <span>MAQUIAGEM</span>
            </div>
        </div>

    </header>

    <main class="conteudo-artistica">

        <div class="apresentacao-artistica">


            <div class="imagem-artistica">
                <img src="/Maquiagem/maquiagem artistica.png" alt="Maquiagem Artística" />
            </div>


            <div class="informacoes-artistica">

                <h2>Maquiagem Artística</h2>

                <p class="descricao">
                    Para produções artísticas e caracterizações especiais.
                </p>

                <p class="texto-descricao">
                    Maquiagem artística desenvolvida para transformar ideias em realidade, utilizando técnicas,
                    cores e efeitos especiais para criar produções únicas e impactantes.
                </p>
            </div>
        </div>

        <section class="bloco-informacao">

            <h3>Benefícios:</h3>

            <ul class="lista-beneficios">

                <li>
                    <span class="check">✓</span>
                    Produção totalmente personalizada.
                </li>

                <li>
                    <span class="check">✓</span>
                    Criatividade e acabamento profissional.
                </li>

                <li>
                    <span class="check">✓</span>
                    Uso de técnicas artísticas avançadas.
                </li>
            </ul>
        </section>

        <section class="bloco-informacao">

            <h3>Duração:</h3>

            <p class="duracao">
                <span class="icone-relogio">◷</span>
                2 a 4 horas, dependendo da complexidade da maquiagem.
            </p>

        </section>

        <section class="bloco-informacao">

            <h3>Para quem é indicado:</h3>

            <p class="indicacao">
                Indicada para pessoas que desejam uma produção criativa.
            </p>

        </section>

    </main>

    <footer class="rodape-agendamento">

        <div class="preco">

            <span>A partir de</span>

            <strong>R$329,87</strong>

        </div>

        <a href="/agendamento" class="botao-agendar">
            AGENDAR AGORA
        </a>

    </footer>

</section>
