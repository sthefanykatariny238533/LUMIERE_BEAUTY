@page "/social"

<PageTitle>Maquiagem Social</PageTitle>

<section class="pagina-social">

    <header class="cabecalho-social">

        <a href="/maquiagem" class="voltar">
            &#8592;
        </a>

        <div class="marca">
            <h1>LUMIÈRE BEAUTY</h1>

            <div class="subtitulo-marca">
                <span>ESTÉTICA</span>
                <span>•</span>
                <span>CABELOS</span>
                <span>•</span>
                <span>MAQUIAGEM</span>
            </div>
        </div>

    </header>

    <main class="conteudo-social">

        <div class="apresentacao-social">

            <div class="imagem-social">
                <img src="/Maquiagem/maquiagem_social.png"
                     alt="Maquiagem Social" />
            </div>

            <div class="informacoes-social">

                <h2>Maquiagem Social</h2>

                <p class="descricao">
                    Para eventos e ocasiões especiais.
                </p>

                <p class="texto-descricao">
                    Maquiagem sofisticada e personalizada para realçar
                    sua beleza e destacar seus melhores traços.
                </p>

            </div>

        </div>

        <section class="bloco-informacao">

            <h3>Benefícios:</h3>

            <ul class="lista-beneficios">

                <li>
                    <span class="check">✓</span>
                    Realça a beleza natural.
                </li>

                <li>
                    <span class="check">✓</span>
                    Acabamento profissional e duradouro.
                </li>

                <li>
                    <span class="check">✓</span>
                    Maior resistência ao calor e à umidade.
                </li>

            </ul>

        </section>


        <section class="bloco-informacao">

            <h3>Duração:</h3>

            <p class="duracao">
                <span class="icone-relogio">◷</span>
                1 hora até 2 horas e meia.
            </p>

        </section>

        <section class="bloco-informacao">

            <h3>Para quem é indicado:</h3>

            <p class="indicacao">
                Ideal para pessoas que desejam uma maquiagem elegante
                e de longa duração para ocasiões especiais.
            </p>

        </section>
    </main>

    <footer class="rodape-agendamento">

        <div class="preco">

            <span>A partir de</span>

            <strong>R$ 150,00</strong>

        </div>

        <a href="/agendamento" class="botao-agendar">
            AGENDAR AGORA
        </a>

    </footer>
</section>
