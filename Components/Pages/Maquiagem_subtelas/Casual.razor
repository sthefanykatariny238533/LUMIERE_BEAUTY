@page "/casual"

<PageTitle>Maquiagem Casual</PageTitle>

<section class="pagina-casual">

    <header class="cabecalho-casual">

        <a href="/maquiagem" class="voltar">
            &#8592;
        </a>

        <div class="marca">
            <h1>LUMIÈRE BEAUTY</h1>

            <div class="subtitulo-marca">
                <span>ESTÉTICA</span>
                <span>•</span>
                <span>CABELOS</span>
                <span>•</span>
                <span>MAQUIAGEM</span>
            </div>
        </div>

    </header>

    <main class="conteudo-casual">

        <div class = "apresentacao-casual">


            <div class="imagem-casual">
                <img src="/Maquiagem/maquiagem_casual.png"
                     alt="Maquiagem Casual" />
            </div>


            <div class="informacoes-casual">

                <h2>Maquiagem Casual</h2>

                <p class="descricao">
                    Para o dia a dia.
                </p>

                <p class="texto-descricao">
                    Maquiagem leve e natural, desenvolvida para realçar a beleza de forma discreta, 
                    proporcionando um acabamento elegante e confortável para qualquer momento.
                </p>

            </div>

        </div>

        <section class="bloco-informacao">

            <h3>Benefícios:</h3>

            <ul class="lista-beneficios">

                <li>
                    <span class="check">✓</span>
                    Aparência natural e sofisticada.
                </li>

                <li>
                    <span class="check">✓</span>
                    Confortável para uso durante o dia.
                </li>

                <li>
                    <span class="check">✓</span>
                    Ideal para uma rotina prática e elegante.
                </li>

            </ul>

        </section>

        <section class="bloco-informacao">

            <h3>Duração:</h3>

            <p class="duracao">
                <span class="icone-relogio">◷</span>
                40 a 60 minutos.
            </p>

        </section>

        <section class="bloco-informacao">

            <h3>Para quem é indicado:</h3>

            <p class="indicacao">
            Indicada para quem deseja um visual natural e delicado.
            </p>

        </section>

    </main>

    <footer class="rodape-agendamento">

        <div class="preco">

            <span>A partir de</span>

            <strong>R$ 100,00</strong>

        </div>

        <a href="/agendamento" class="botao-agendar">
            AGENDAR AGORA
        </a>

    </footer>

</section>
