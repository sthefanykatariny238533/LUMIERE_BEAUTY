@page "/cabelo"

<PageTitle>Cabelo</PageTitle>

<section class="pagina-cabelo">

    <section class="banner-cabelo">

        <a href="/" class="voltar-cabelo">
            &#8592;
        </a>

        <div class="titulo-cabelo">

            <div class="linha-cabelo"></div>

            <div class="texto-cabelo">
                <h1>CABELO</h1>
                <p>Escolha o serviço ideal para você.</p>
            </div>

            <div class="linha-cabelo"></div>
        </div>
    </section>


    <section class="lista-cabelo">

        <div class="servico-cabelo">

            <img src="/Cabelo/Corte.png"
                 alt="Cortes de cabelo">

            <div class="informacoes-cabelo">
                <h2>Cortes</h2>

                <p>
                    Estilos que combinam<br />
                    com você
                </p>

                <a href="/corte">
                    Ver modelos
                </a>
            </div>

            <a href="/corte" class="seta-cabelo">
                &#8250;
            </a>

        </div>

        <div class="servico-cabelo">

            <img src="/Cabelo/Penteado.png"
                 alt="Penteado">

            <div class="informacoes-cabelo">
                <h2>Penteado</h2>

                <p>
                    Penteados para todas as<br />
                    ocasiões
                </p>

                <a href="/penteado">
                    Ver modelos
                </a>
            </div>

            <a href="/penteado" class="seta-cabelo">
                &#8250;
            </a>

        </div>

        <div class="servico-cabelo">

            <img src="/Cabelo/Hidratacao.png"
                 alt="Hidratação">

            <div class="informacoes-cabelo">
                <h2>Hidratação</h2>

                <p>
                    Cabelos saudáveis e<br />
                    brilhantes
                </p>

                <a href="/hidratacao">
                    Ver modelos
                </a>
            </div>

            <a href="/hidratacao" class="seta-cabelo">
                &#8250;
            </a>

        </div>

        <div class="servico-cabelo">

            <img src="/Cabelo/Escova.png"
                 alt="Escova">

            <div class="informacoes-cabelo">
                <h2>Escova</h2>

                <p>
                    Mais brilho e<br />
                    movimento para os<br />
                    seus cabelos
                </p>

                <a href="/escova">
                    Ver modelos
                </a>
            </div>

            <a href="/escova" class="seta-cabelo">
                &#8250;
            </a>

        </div>

        <div class="servico-cabelo">

            <img src="/Cabelo/Alisamento.png"
                 alt="Alisamento">

            <div class="informacoes-cabelo">
                <h2>Alisamento</h2>

                <p>
                    Para cabelos lisos,<br />
                    alinhados e sem frizz.
                </p>

                <a href="/alisamento">
                    Ver modelos
                </a>
            </div>

            <a href="/alisamento" class="seta-cabelo">
                &#8250;
            </a>

        </div>

        <div class="servico-cabelo">

            <img src="/Cabelo/Completo.png"
                 alt="Serviço completo">

            <div class="informacoes-cabelo">
                <h2>Completo</h2>

                <p>
                    Corte + hidratação +<br />
                    escova + alisamento +<br />
                    penteado
                </p>

                <a href="/completo">
                    Ver modelos
                </a>
            </div>

            <a href="/completo" class="seta-cabelo">
                &#8250;
            </a>

        </div>
    </section>
</section>
